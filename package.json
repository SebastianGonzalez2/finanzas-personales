{
  "name": "finanzas-personales",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:auth": "node --env-file=.env.runtime.local node_modules/next/dist/bin/next dev --webpack --hostname 127.0.0.1",
    "auth:deploy:prepare": "node --conditions=react-server scripts/prepare-f0-04-deployment.mjs",
    "probe:auth:published": "node scripts/probe-f0-04-published.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build",
    "test": "npm run test:unit",
    "test:unit": "node --conditions=react-server --test tests/unit/*.test.mjs tests/auth/*.test.mjs",
    "test:integration": "node --conditions=react-server --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:auth:ui": "playwright test --config playwright.auth-ui.config.ts",
    "probe:neon": "node --conditions=react-server --env-file-if-exists=.env.local scripts/probe-neon-development.mjs",
    "probe:auth:development": "node --env-file-if-exists=.env.local scripts/probe-f0-04.mjs",
    "auth:sql:plan": "node scripts/prepare-f0-04.mjs",
    "auth:sql:apply": "node --env-file-if-exists=.env.local scripts/prepare-f0-04.mjs",
    "auth:invitation": "node --env-file-if-exists=.env.local scripts/rotate-f0-04-invitation.mjs",
    "auth:invitation:prepare": "node scripts/prepare-f0-04-invitation.mjs",
    "test:auth:development": "node --conditions=react-server --env-file-if-exists=.env.local scripts/test-f0-04-admission.mjs",
    "auth:runtime:prepare": "node --conditions=react-server --env-file-if-exists=.env.local scripts/provision-f0-04-runtime.mjs",
    "test:auth:runtime": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=.env.runtime.local scripts/test-f0-04-runtime.mjs",
    "db:plan": "node scripts/migrate-development.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-development.mjs",
    "test:db:development": "node --conditions=react-server --env-file-if-exists=.env.local scripts/test-development-schema.mjs"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "clsx": "2.1.1",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
