# F0-NEON: development only. See docs/development-neon.md.
# Empty values are intentional. Copy to .env.local without overwriting it.
# Never put credentials here, in chat/PR, or in NEXT_PUBLIC_* variables.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# F0-04: separate restricted LOGIN roles; NEVER reuse owner DATABASE_URL.
DATABASE_RUNTIME_URL=
DATABASE_ADMISSION_URL=
NEON_ADMISSION_SECRET=
AUTH_APP_ORIGIN=
# Leave false until approved SQL, blocking webhook and real tests pass.
NEON_AUTH_ADMISSION_READY=false
# Optional administrative rotation input; do not deploy this variable.
NEON_NEXT_INVITATION_CODE=
