# F0-NEON: development only. See docs/development-neon.md.
# Empty values are intentional. Copy to .env.local without overwriting it.
# Never put credentials here, in chat/PR, or in NEXT_PUBLIC_* variables.
NEON_PROJECT_ID=
NEON_BRANCH_ID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# F0-04 v9.49 Google-only. Runtime file: .env.google.local (never tracked).
# Old NEON_AUTH_* values above are historical probe inputs, not runtime auth.
GOOGLE_AUTH_READY=false
GOOGLE_AUTH_ORIGIN=http://localhost:3000
GOOGLE_AUTH_SECRET=
# Clave estable e independiente de 32 bytes hex para firmar copias financieras.
FINANCE_BACKUP_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_DATABASE_URL=
GOOGLE_FINANCE_DATABASE_URL=

# OPS: el destino Neon lo fija el entorno (VERCEL_ENV), no estas variables.
# Production -> rama production; Preview/local -> rama development. Las variables
# NEON_PROJECT_ID, NEON_BRANCH_ID y las URLs deben coincidir con ese destino o la
# aplicación falla (nunca hace fallback). Ver docs/development-neon.md.
